# --- Core ---
# Ganti dengan string acak panjang di production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me
# SQLite default (dev). Production: mysql+pymysql://user:pass@host/db  atau  postgresql+psycopg://...
DATABASE_URL=sqlite:///./aidiag.db

# --- Worker ---
# local = asyncio in-process (dev/single-node) | celery = Redis broker (production)
WORKER_BACKEND=local

# --- Doubao (Volcano Ark) ---
# Kosongkan untuk mode mock. Isi untuk pakai API nyata (bisa juga via panel admin).
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250615

# --- SMS ---
# mock = kode dikembalikan di response dev & log | aliyun | tencent
SMS_PROVIDER=mock

# --- Frontend (untuk QR & render PDF) ---
H5_BASE_URL=http://localhost:5173

# --- CORS dev ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
